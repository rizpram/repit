# Fill privately. Only authorized project; session pooler port 5432.
TELEGRAM_BOT_TOKEN=replace_locally
TELEGRAM_ALLOWED_USER_ID=0
DATABASE_URL=postgresql://postgres.lzfrfpokshfrbnbaiuqo:replace_locally@YOUR_SESSION_POOLER:5432/postgres
DATABASE_CA_FILE=/run/secrets/supabase-ca.crt
# --- Optional AI (all off by default). Enabling a feature consents to sending
# that data to the configured providers. Keys stay private on the server.
# Gemini is primary for every feature; a GEMINI_API_KEY alone runs everything.
# Gemini free tier (key from aistudio.google.com, separate from Google AI Pro):
# no cost within rate limits, but Google may use free-tier inputs (food photos,
# meal text, weekly aggregates) to improve its products.
GEMINI_API_KEY=
# Optional paid fallbacks, tried only if Gemini fails. Leave empty to skip.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Food photo estimate (draft until /confirmfood)
AI_VISION_ENABLED=false
# "/food nasi padang rendang" estimate (draft until /confirmfood)
AI_FOOD_TEXT_ENABLED=false
# AI narrative appended to the deterministic weekly recap (only aggregates are sent)
AI_COACH_ENABLED=false
# Optional overrides. Default chains: vision gemini,openai,anthropic;
# food_text gemini,openai,anthropic; coach gemini,anthropic,openai
# AI_ROUTE_VISION=
# AI_ROUTE_FOOD_TEXT=
# AI_ROUTE_COACH=
# Default models: Gemini gemini-3.8-flash (food_text: gemini-3.5-flash-lite),
# OpenAI gpt-6-luna, Claude claude-sonnet-5-5.
# Per feature: AI_MODEL_<PROVIDER>_<FEATURE>, e.g. AI_MODEL_GEMINI_COACH=
# AI_MODEL_GEMINI=
# AI_MODEL_OPENAI=
# AI_MODEL_ANTHROPIC=
