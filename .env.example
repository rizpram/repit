# Fill privately. Only authorized project; session pooler port 5432.
TELEGRAM_BOT_TOKEN=replace_locally
TELEGRAM_ALLOWED_USER_ID=0
DATABASE_URL=postgresql://postgres.lzfrfpokshfrbnbaiuqo:replace_locally@YOUR_SESSION_POOLER:5432/postgres
DATABASE_CA_FILE=/run/secrets/supabase-ca.crt
# --- Optional AI (all off by default). Enabling a feature consents to sending
# that data to the configured providers and may incur cost. Keys stay private.
# Missing key = provider skipped. Next provider in the chain is tried on failure.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini key from Google AI Studio (separate from a Google AI Pro subscription)
GEMINI_API_KEY=
# Food photo estimate (draft until /confirmfood). Default chain: gemini,openai,anthropic
AI_VISION_ENABLED=false
# "/food nasi padang rendang" estimate (draft until /confirmfood). Default chain: openai,gemini,anthropic
AI_FOOD_TEXT_ENABLED=false
# AI narrative appended to the deterministic weekly recap (only aggregates are sent).
# Default chain: anthropic,gemini,openai
AI_COACH_ENABLED=false
# Optional overrides, e.g. AI_ROUTE_COACH=anthropic,openai
# AI_ROUTE_VISION=
# AI_ROUTE_FOOD_TEXT=
# AI_ROUTE_COACH=
# Optional model overrides (defaults: gpt-6-luna, claude-sonnet-5-5, gemini-3.8-flash).
# Per feature: AI_MODEL_<PROVIDER>_<FEATURE>, e.g. AI_MODEL_ANTHROPIC_COACH=
# AI_MODEL_OPENAI=
# AI_MODEL_ANTHROPIC=
# AI_MODEL_GEMINI=
